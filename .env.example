# ==============================================================================
# minimi-ai-chat-agent Environment Configuration
# ==============================================================================

# Server Runtime Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=3000

# CORS Allowed Origins (Comma-separated list or * for all)
CORS_ORIGIN=*

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# API Base Route Prefix
API_PREFIX=/api

# Request Body Size Limit
REQUEST_BODY_LIMIT=1mb

# ------------------------------------------------------------------------------
# Future Phase Placeholders (Do NOT populate until respective phase)
# ------------------------------------------------------------------------------
# LLM Provider Configuration (Phase 4)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Web Search Provider Configuration (Phase 3)
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=your_tavily_api_key_here

# Database Configuration (Phase 3)
# DATABASE_PATH=./data/minimi.db
