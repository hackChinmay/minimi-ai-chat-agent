# ==============================================================================
# minimi-ai-chat-agent Environment Configuration
# ==============================================================================

# Server Runtime Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=3000

# CORS Allowed Origins (Comma-separated list or * for all)
CORS_ORIGIN=*

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# API Base Route Prefix
API_PREFIX=/api

# Request Body Size Limit
REQUEST_BODY_LIMIT=1mb

# ------------------------------------------------------------------------------
# Web Search Configuration (Phase 3)
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Conversation Memory & Storage Configuration (Phase 4)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=inmemory
MONGODB_URI=
MAX_CONTEXT_MESSAGES=10
MAX_MESSAGE_LENGTH=10000

# ------------------------------------------------------------------------------
# LLM Provider & Agent Orchestration Configuration (Phase 5)
# ------------------------------------------------------------------------------
# Active LLM provider: 'openai' (production/live) or 'mock' (offline testing)
LLM_PROVIDER=openai

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Model selection (e.g., gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible endpoints (supports Groq, OpenRouter, Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM request timeout in milliseconds
LLM_TIMEOUT_MS=15000

# Sampling temperature (0.0 to 1.0)
LLM_TEMPERATURE=0.2

# Maximum token output ceiling
LLM_MAX_TOKENS=1000
